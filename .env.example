# Obrigatório para persistir leads no MySQL/TiDB.
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO

# Obrigatório somente se o fluxo Manus OAuth for reativado.
JWT_SECRET=COLOCAR_AQUI

# Chave pública do Web3Forms usada no navegador para notificar o responsável.
# Nunca substitua este placeholder por uma chave em um repositório público.
VITE_WEB3FORMS_ACCESS_KEY=COLOCAR_AQUI

# Opcional: Umami. Se vazios, nenhum script Umami será carregado.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Opcional para o servidor Node.
NODE_ENV=development
PORT=3000

# Opcional, somente se o template de autenticação Manus for reativado:
# VITE_APP_ID=COLOCAR_AQUI
# OAUTH_SERVER_URL=COLOCAR_AQUI
# VITE_OAUTH_PORTAL_URL=COLOCAR_AQUI
# OWNER_OPEN_ID=COLOCAR_AQUI
# OWNER_NAME=COLOCAR_AQUI
